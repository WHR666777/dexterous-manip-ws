  <link name="link1"/><link name="link2"/><link name="link3"/>
  <link name="link4"/><link name="link5"/><link name="link6"/><link name="link7"/>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.138" rpy="0 0 0"/><parent link="base_link"/><child link="link1"/>
    <axis xyz="0 0 1"/><limit lower="-2.70526" upper="2.70526" effort="100" velocity="5"/>
  </joint>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="1.5707963 3.1415926 0"/><parent link="link1"/><child link="link2"/>
    <axis xyz="0 0 1"/><limit lower="-1.74" upper="1.74" effort="100" velocity="5"/>
  </joint>
  <joint name="joint3" type="revolute">
