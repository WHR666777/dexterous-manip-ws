  </joint>
  <joint name="joint4" type="revolute">
    <origin xyz="0 0 0" rpy="-1.5707963 0 3.1415926926"/><parent link="link3"/><child link="link4"/>
    <axis xyz="0 0 1"/><limit lower="-1.01" upper="2.14" effort="100" velocity="5"/>
  </joint>
  <joint name="joint5" type="revolute">
