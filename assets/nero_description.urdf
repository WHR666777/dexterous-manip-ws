<?xml version="1.0"?>
<!--
  Kinematic-only extraction of AgileX agx_arm_urdf/nero/urdf/nero_description.urdf.
  Joint origins, axes and limits are unchanged; visual/collision meshes are not
  needed by the local numerical IK parser.
  Source: https://github.com/agilexrobotics/agx_arm_urdf
  Verified against commit f6642ce0d7872c686f29c99e9e10cd23d1d49313.
-->
<robot name="nero">
